# Copy to .env and fill in real values. Never commit .env.
#
# Host values below (`db`, `redis`) are the Docker Compose *service
# names* from docker-compose.yml — use these when running via
# `docker-compose up` (the api/worker containers reach Postgres/Redis by
# service name, not `localhost`, since `localhost` inside a container
# means the container itself). Running the app directly on your machine
# instead (no Docker)? Change both hosts to `localhost` — the compose
# file publishes 5432/6379 to your host machine too, so that still works.

ENVIRONMENT=development

# Postgres
DATABASE_URL=postgresql+asyncpg://hnbg:hnbg@db:5432/hnbg_task_management

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Notifications: SMS + Email for high/urgent priority tickets ---

NOTIFICATIONS_ENABLED=true
NOTIFY_PRIORITIES=high,urgent

# Email (SMTP — swap for SendGrid/SES creds if using one of those instead)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=notifications@hnbg.example
SMTP_USE_TLS=true

# SMS (Twilio)
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
TWILIO_FROM_NUMBER=+10000000000
